# ─────────────────────────────────────────────────────────────
# OFIXIS — variables d'environnement
# Copier ce fichier en `.env.local` et renseigner les valeurs.
# Aucun secret ne doit être commité dans Git.
# ─────────────────────────────────────────────────────────────

# `preproduction` (défaut) ou `production`.
# En préproduction, le site est interdit d'indexation (robots.txt + X-Robots-Tag)
# et un bandeau signale qu'il s'agit d'une version de recette.
NEXT_PUBLIC_ENVIRONNEMENT=preproduction

# URL canonique du site, sans slash final.
NEXT_PUBLIC_URL_SITE=https://www.ofixis.fr

# ── Espace client ────────────────────────────────────────────
# URL du portail client. Tant que cette variable est vide,
# le bouton « Espace client » n'est affiché nulle part.
NEXT_PUBLIC_URL_ESPACE_CLIENT=

# ── Prise de rendez-vous (Microsoft Bookings) ────────────────
# URL publique de la page Bookings du cabinet. Tant qu'elle est vide,
# la page /prendre-rendez-vous propose le téléphone et le formulaire.
NEXT_PUBLIC_URL_BOOKINGS=

# ── Formulaire de contact — envoi via Microsoft 365 ──────────
# L'envoi passe par Microsoft Graph. La soumission SMTP par authentification
# basique n'est plus utilisable : Microsoft l'a définitivement désactivée dans
# Exchange Online le 30 avril 2026.
#
# Mise en place (voir GUIDE_MICROSOFT_365.md) :
#   1. inscrire une application dans Microsoft Entra ID ;
#   2. lui accorder le rôle Exchange `Application Mail.Send` restreint à la
#      seule boîte d'envoi — et AUCUNE permission dans Entra, les deux
#      mécanismes s'additionnant, une permission Entra annulerait la
#      restriction ;
#   3. générer un secret client et le reporter ci-dessous.

# Identifiant du locataire (tenant) Microsoft Entra.
MS_TENANT_ID=

# Identifiant de l'application inscrite.
MS_CLIENT_ID=

# Secret client. À traiter comme un mot de passe : jamais dans Git, à
# renouveler avant son expiration.
MS_CLIENT_SECRET=

# Boîte aux lettres depuis laquelle les messages sont envoyés.
# Une boîte dédiée (site@ofixis.fr) isole les éventuels problèmes de
# délivrabilité de la messagerie courante du cabinet.
MS_BOITE_EXPEDITRICE=

# Destinataire interne des demandes (plusieurs adresses séparées par une virgule).
# Valeur retenue par le cabinet le 10 septembre 2026 :
EMAIL_DESTINATAIRE=contact@ofixis.fr

# ── Mesure d'audience (optionnelle, sans cookie) ─────────────
# Domaine déclaré dans Plausible. Vide = aucune mesure, aucun script tiers.
NEXT_PUBLIC_PLAUSIBLE_DOMAINE=

# ── Formulaire : limitation de débit ─────────────────────────────
# Nombre d'envois tolérés par adresse IP et par tranche de 10 minutes.
# Valeur par défaut : 3. À ne relever que pour les tests automatisés.
CONTACT_MAX_ENVOIS=3
